{
  "name": "@sollish/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:integration": "node test/workerd.integration.mjs",
    "test:arena": "node --import tsx test/live-arena.workerd.mjs && node --import tsx test/live-arena-router.workerd.mjs",
    "test:arena:stress": "node --import tsx test/live-arena-stress.workerd.mjs",
    "test:contact": "node --import tsx test/contact-arena.workerd.mjs",
    "test:ringside": "node --import tsx test/ringside-arena.workerd.mjs"
  },
  "dependencies": {
    "@sollish/protocol": "workspace:*",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "wrangler": "4.145.0"
  }
}
