# Use direct PostgreSQL5432 or the Supabase SESSION pooler5432.
# Transaction pooler6543 is incompatible with the indexer's session advisory lock.
# Session-pooler username: sollish_worker.<project-ref>; direct username: sollish_worker.
DATABASE_URL=postgresql://sollish_worker.your-project-ref:replace@your-session-pooler:5432/postgres
SOLANA_RPC_URL=https://api.devnet.solana.com
HOUSE_ADDRESS=
# SHA256 of finalized upgradeable ProgramData bytes AFTER45-byte metadata,
# including deployment allocation padding. Pin from a reviewed deployment.
GAMES_PROGRAM_DATA_SHA256=
REALTIME_URL=http://localhost:8787
PUBLISH_SIGNING_KEY=replace-with-same-at-least-32-byte-secret-as-realtime
WORKER_PORT=8790

# Keeper remains disabled unless ALL explicit limits, pins and private paths exist.
KEEPER_ENABLED=false
HOUSE_AUTHORITY=
HOUSE_PROGRAM_DATA_SHA256=
KEEPER_SHARD_ID=0
KEEPER_FEE_KEY_PATH=
KEEPER_JOURNAL_PATH=
KEEPER_MAX_FEE_LAMPORTS=
KEEPER_LIFETIME_BUDGET_LAMPORTS=
KEEPER_MIN_BALANCE_LAMPORTS=
