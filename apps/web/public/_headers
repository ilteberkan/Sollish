# Cloudflare Workers static-asset headers (copied to .open-next/assets by build:cloudflare). Policy and reasons:
# docs/architecture/scale.md "Web caching". Rule: a file may be `immutable` only when its URL changes whenever its bytes
# change (content hash in the name or in a ?v= query that every consumer uses). Everything else revalidates with ETag.

# Next build output: content-hashed file names.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts (next/font also emits hashed copies under /_next/static/media).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Audio render worker: the only consumer loads /workers/slot-audio-render.js?v=<sha256 of the bytes>
# (scripts/build-audio-worker.mjs writes the hash into lib/slot-audio/worker-version.generated.ts).
/workers/*
  Cache-Control: public, max-age=31536000, immutable

# Voice lines: every loader builds `<folder>/<stem>.mp3?v=<hash of that game/language folder>` through
# lib/slot-audio/voice-version.ts (hashes generated by scripts/build-audio-worker.mjs), so the URL changes whenever any file
# of the folder changes and the files can be immutable. Keep any new voice consumer on versionedVoiceUrl().
# (Not "/audio/*": Workers merge matching rules and would join two Cache-Control values.)
/audio/voice/*
  Cache-Control: public, max-age=31536000, immutable

# Ringside sprites/audio and images keep stable names and are replaced in place, so they are NOT immutable:
# one hour fresh, then served stale for up to a day while the browser revalidates (304 with ETag, no body).
# Move a folder to `immutable` only after its consumers load versioned URLs (scale.md "Versioned asset URLs").
/audio/ringside/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/sprites/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/images/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
