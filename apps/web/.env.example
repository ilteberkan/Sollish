NEXT_PUBLIC_HOUSE_SHARD_ID=0
NEXT_PUBLIC_TOKEN_MINT=
NEXT_PUBLIC_INCENTIVES_ENABLED=false
NEXT_PUBLIC_STAKING_POOL_ID=
